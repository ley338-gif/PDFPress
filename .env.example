APP_PORT=8080
MAX_FILE_SIZE_MB=100
MAX_PAGES=200
DOCUMENT_RETENTION_MINUTES=60
OCR_LANGUAGE=deu+eng
OCR_DPI=200
OCR_TIMEOUT_SECONDS=90
PROCESSING_TIMEOUT_SECONDS=1800
MAX_CONCURRENT_JOBS=3
MAX_RENDER_PIXELS=50000000
PAGE_RENDER_TIMEOUT_SECONDS=60
ENABLE_API_DOCS=false
LLM_ENABLED=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:1.7b
# Setzt/aktiviert den Admin-Dashboard-Bereich unter /api/admin (Basic Auth, Passwort =
# dieses Token). Leer lassen, um den Admin-Bereich komplett zu deaktivieren.
ADMIN_TOKEN=
# Pfad zur Statistik-Datei (nur aggregierte Zähler, siehe backend/app/stats.py). In Docker
# zeigt der Default auf das persistente Volume; für lokale Testläufe außerhalb von Docker
# hier z. B. auf ./scratch/stats.json umbiegen, um keine echten Systempfade zu treffen.
STATS_FILE=/data/stats.json

